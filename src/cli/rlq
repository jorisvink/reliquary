set -e

if [ -z "$RELIQUARY" ]; then
	RELIQUARY=$HOME/.config/reliquary
fi

DIR=$RELIQUARY

check_dependency() {
	if command -v $1 > /dev/null 2>&1; then
		if [ "$2" = "quiet" ]; then
			return 0
		else
			printf "    $1 \33[0;32m\xe2\x9c\x93\033[0m\n"
			return 0
		fi
	else
		if [ "$2" = "quiet" ]; then
			return 1
		else
			printf "    $1 \33[0;31mx\033[0m\n"
			return 1
		fi
	fi
}

require_dependency() {
	if ! check_dependency $1 quiet; then
		echo "$1 dependency missing"
		exit 1
	fi
}

