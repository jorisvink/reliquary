}

cmd_cathedral_list() {
	if [ $# -ne 0 ]; then
		echo "Usage: rlq cathedral list"
		echo ""
		echo "Lists all cathedrals available in this reliquary."
		echo ""
		echo "You can reconfigure tunnels to use whichever cathedral"
